NUM_ELEMENTS_IN_LIST   ring_block_description_list  = 5
STR      ring_block_parameter_file                  = "/data/4/users/mdas/Softwares/simset/2.9.2_new_mat_table/repo/scanner/modularjpet/modular4.blocparms"
REAL     ring_block_radial_position                 = 36.98600000000000
