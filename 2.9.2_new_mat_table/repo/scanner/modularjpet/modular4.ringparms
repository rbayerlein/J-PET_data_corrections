# RING OUTER DIMENSIONS
# Provides the outer dimensions of the ring: all the blocks must fall entirely
# within these boundaries.  The ring is bounded with a maximum and minimum
# z value axially and by elliptical cylinders transaxially.  These bounds are not
# in tomograph coordinates: the ring can shifted up or down axially or rotated
# transaxially when placing it in the tomograph.
REAL	ring_x_inner_radius     =   36.98600000000000
REAL	ring_x_outer_radius     =   40.38600000000000
REAL	ring_y_inner_radius     =   36.98600000000000
REAL	ring_y_outer_radius     =   40.38600000000000
REAL	ring_z_minimum          =   -25.00000000000000
REAL	ring_z_maximum          =   25.00000000000000

NUM_ELEMENTS_IN_LIST   ring_num_blocks_in_ring  = 24

